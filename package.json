{
  "name": "ate05",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo dev --filter=@ate05/pos",
    "dev:reset": "node scripts/reset-dev-data.mjs",
    "build": "turbo build",
    "test": "turbo test && playwright test",
    "test:unit": "turbo test",
    "test:e2e": "playwright test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "tauri": "pnpm --filter @ate05/pos tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.7.0",
    "turbo": "^2.7.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
