{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATE05 POS",
  "version": "0.1.0",
  "identifier": "com.ate05.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATE05 POS",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ate05.db"]
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
